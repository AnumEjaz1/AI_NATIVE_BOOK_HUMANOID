/* ===== Hero Section Enhancement ===== */
.heroBanner {
  display: flex;
  flex-direction: column;
  justify-content: center; /* vertical centering */
  align-items: center;     /* horizontal centering */
  text-align: center;
  padding: 6rem 2rem;
  min-height: 80vh;
  background: linear-gradient(135deg, var(--ifm-color-primary-lightest) 0%, var(--ifm-color-primary-lighter) 100%);
  position: relative;
  overflow: hidden;
}

.hero__title {
  font-size: 3rem;
  font-weight: 700;
  margin-bottom: 1rem;
}

.hero__subtitle {
  font-size: 1.4rem;
  max-width: 650px;
  line-height: 1.6;
  margin-bottom: 2rem;
  opacity: 0.9;
}

.buttons {
  display: flex;
  justify-content: center;
  gap: 1.2rem;
  flex-wrap: wrap;
}

.button--secondary {
  padding: 0.8rem 2rem;
  font-size: 1.1rem;
}

/* ===== Module Cards Enhancement ===== */
.features .text--center.padding-horiz--md {
  padding: 2rem 1.5rem;
  background: var(--ifm-background-surface-color);
  border-radius: 12px;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-shadow: 0 6px 20px rgba(0,0,0,0.08);
  transition: all 0.3s ease;
}

.features .text--center.padding-horiz--md:hover {
  transform: translateY(-6px);
  box-shadow: 0 12px 30px rgba(0,0,0,0.15);
  border-color: var(--ifm-color-primary-light);
}

.features h3 {
  font-size: 1.4rem;
  margin-bottom: 1rem;
  color: var(--ifm-color-primary);
}

.features p {
  font-size: 1rem;
  line-height: 1.6;
  color: var(--ifm-color-emphasis-600);
  flex-grow: 1;
}

/* ===== Section Spacing ===== */
.main-wrapper {
  max-width: 900px;
  margin: 0 auto;
  padding: 0 1.5rem;
}

.sectionTitle {
  text-align: center;
  font-size: 2.2rem;
  margin-bottom: 0.8rem;
}

.sectionSubtitle {
  text-align: center;
  font-size: 1.2rem;
  margin-bottom: 2rem;
  opacity: 0.85;
}

/* ===== Dark Mode Adjustments ===== */
[data-theme='dark'] .heroBanner {
  background: linear-gradient(135deg, var(--ifm-color-primary-darkest) 0%, var(--ifm-color-primary-darker) 100%);
}

[data-theme='dark'] .features .text--center.padding-horiz--md {
  background: var(--ifm-color-emphasis-level-100);
  border-color: var(--ifm-color-emphasis-300);
}